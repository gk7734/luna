#!/usr/bin/env bash
# Builds Luna.app from source so Luna can be opened from the Dock, Finder or Spotlight.
# Usage: script/bundle-luna-mac [--install | --dmg]
#   --install copies it to ~/Applications; --dmg packs it into target/release/Luna-<version>-<arch>.dmg
# Set LUNA_SIGNING_IDENTITY (a Developer ID Application identity) to sign for distribution, and
# LUNA_NOTARY_PROFILE (a notarytool keychain profile) to also notarize and staple the DMG.

set -euo pipefail

cd "$(dirname "$0")/.."
target_dir="${CARGO_TARGET_DIR:-target}"
version="$(sed -n 's/^version = "\(.*\)"$/\1/p' crates/zed/Cargo.toml | head -n 1)"
app="$target_dir/release/Luna.app"

# The terminal's libghostty-vt is built with Zig 0.15, which Homebrew installs keg-only.
if [ -d /opt/homebrew/opt/zig@0.15/bin ]; then
    export PATH="/opt/homebrew/opt/zig@0.15/bin:$PATH"
fi
command -v zig >/dev/null || { echo "Zig 0.15 is needed: brew install zig@0.15" >&2; exit 1; }

cargo build --release --package zed

rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$target_dir/release/luna" "$app/Contents/MacOS/luna"
cp crates/zed/resources/Document.icns "$app/Contents/Resources/Document.icns"

iconset="$(mktemp -d)/Luna.iconset"
mkdir -p "$iconset"
for size in 16 32 128 256 512; do
    sips -z "$size" "$size" crates/zed/resources/app-icon@2x.png --out "$iconset/icon_${size}x${size}.png" >/dev/null
    double=$((size * 2))
    sips -z "$double" "$double" crates/zed/resources/app-icon@2x.png --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil --convert icns "$iconset" --output "$app/Contents/Resources/Luna.icns"

{
    cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
<key>CFBundleName</key>
<string>Luna</string>
<key>CFBundleDisplayName</key>
<string>Luna</string>
<key>CFBundleIdentifier</key>
<string>io.github.gk7734.luna</string>
<key>CFBundleExecutable</key>
<string>luna</string>
<key>CFBundleIconFile</key>
<string>Luna</string>
<key>CFBundlePackageType</key>
<string>APPL</string>
<key>CFBundleShortVersionString</key>
<string>${version}</string>
<key>CFBundleVersion</key>
<string>${version}</string>
<key>LSApplicationCategoryType</key>
<string>public.app-category.developer-tools</string>
<key>LSMinimumSystemVersion</key>
<string>10.15.7</string>
<key>NSHighResolutionCapable</key>
<true/>
PLIST
    cat crates/zed/resources/info/*.plist
    cat <<PLIST
</dict>
</plist>
PLIST
} > "$app/Contents/Info.plist"
plutil -lint "$app/Contents/Info.plist" >/dev/null

# Notarization needs a Developer ID signature with the hardened runtime. Without one, an ad-hoc
# signature still keeps macOS from treating every rebuild as a new, unknown app.
signing_identity="${LUNA_SIGNING_IDENTITY:-}"
if [ -n "$signing_identity" ]; then
    codesign --force --timestamp --options runtime --entitlements crates/zed/resources/zed.entitlements \
        --sign "$signing_identity" "$app/Contents/MacOS/luna"
    codesign --force --timestamp --options runtime --entitlements crates/zed/resources/zed.entitlements \
        --sign "$signing_identity" "$app"
else
    codesign --force --deep --sign - "$app"
fi

make_dmg() {
    # The architecture is named the way Rust names it, which is what the updater looks for.
    local arch
    arch="$(rustc -vV | sed -n 's/^host: \([^-]*\)-.*/\1/p')"
    local dmg="$target_dir/release/Luna-${version}-${arch}.dmg"
    local staging writable_dmg volume
    staging="$(mktemp -d)"
    writable_dmg="$(mktemp -d)/Luna.dmg"
    volume="/Volumes/Luna"

    if [ -d "$volume" ]; then
        echo "$volume is already mounted; eject it first" >&2
        exit 1
    fi

    mkdir -p "$staging/.background"
    cp -R "$app" "$staging/Luna.app"
    cp crates/zed/resources/luna/dmg-background.tiff "$staging/.background/background.tiff"
    ln -s /Applications "$staging/Applications"
    hdiutil create -volname Luna -srcfolder "$staging" -fs HFS+ -format UDRW -ov "$writable_dmg" >/dev/null
    hdiutil attach -readwrite -noverify -noautoopen "$writable_dmg" >/dev/null

    # Hidden rather than moved off to the side: anything placed outside the window makes Finder let
    # the window scroll to it.
    chflags hidden "$volume/.background"

    # Finder keeps the window layout in the volume's .DS_Store, so it has to lay the window out
    # itself. The icon positions match the arrow and name tags drawn in dmg-background.svg.
    osascript <<APPLESCRIPT
tell application "Finder"
    tell disk "Luna"
        open
        set current view of container window to icon view
        set toolbar visible of container window to false
        set statusbar visible of container window to false
        set pathbar visible of container window to false
        set the bounds of container window to {200, 120, 860, 548}
        set viewOptions to the icon view options of container window
        set arrangement of viewOptions to not arranged
        set icon size of viewOptions to 128
        set text size of viewOptions to 13
        set background picture of viewOptions to file ".background:background.tiff"
        set extension hidden of item "Luna.app" to true
        set position of item "Luna.app" of container window to {180, 186}
        set position of item "Applications" of container window to {480, 186}
        -- The hidden folders only show for people who show hidden files, but left unplaced Finder
        -- drops them in the top-left and shifts every icon, and placed outside the window they make
        -- it scroll. .fseventsd is removed before the image is compressed.
        try
            set position of item ".background" of container window to {585, 75}
        end try
        try
            set position of item ".fseventsd" of container window to {330, 186}
        end try
        close
        open
        update without registering applications
        delay 2
        close
    end tell
end tell
APPLESCRIPT

    # Finder writes the layout to .DS_Store on its own time; detaching before it settles ships a
    # window with some settings missing, such as the icon size.
    local previous_size="" stable_checks=0
    for _ in $(seq 1 30); do
        local size
        size="$(stat -f %z "$volume/.DS_Store" 2>/dev/null || true)"
        if [ -n "$size" ] && [ "$size" = "$previous_size" ]; then
            stable_checks=$((stable_checks + 1))
            [ "$stable_checks" -ge 3 ] && break
        else
            stable_checks=0
        fi
        previous_size="$size"
        sleep 1
    done
    if [ ! -f "$volume/.DS_Store" ]; then
        echo "Finder didn't save the window layout to $volume/.DS_Store" >&2
        exit 1
    fi

    rm -rf "$volume/.fseventsd"
    sync
    hdiutil detach "$volume" -quiet
    hdiutil convert "$writable_dmg" -format UDZO -imagekey zlib-level=9 -ov -o "$dmg" >/dev/null
    rm -rf "$staging" "$(dirname "$writable_dmg")"

    if [ -n "$signing_identity" ]; then
        codesign --force --timestamp --sign "$signing_identity" "$dmg"
    fi
    # The profile is made once with `xcrun notarytool store-credentials`, so no secret passes through here.
    if [ -n "${LUNA_NOTARY_PROFILE:-}" ]; then
        if [ -z "$signing_identity" ]; then
            echo "Notarization needs LUNA_SIGNING_IDENTITY set to a Developer ID Application identity" >&2
            exit 1
        fi
        xcrun notarytool submit "$dmg" --keychain-profile "$LUNA_NOTARY_PROFILE" --wait
        xcrun stapler staple "$dmg"
    fi
    echo "Built $dmg"
}

case "${1:-}" in
    --install)
        mkdir -p "$HOME/Applications"
        rm -rf "$HOME/Applications/Luna.app"
        cp -R "$app" "$HOME/Applications/Luna.app"
        echo "Installed $HOME/Applications/Luna.app"
        ;;
    --dmg)
        make_dmg
        ;;
    *)
        echo "Built $app"
        ;;
esac
