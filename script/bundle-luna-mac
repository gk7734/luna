#!/usr/bin/env bash
# Builds Luna.app from source so Luna can be opened from the Dock, Finder or Spotlight.
# Usage: script/bundle-luna-mac [--install | --dmg]
#   --install copies it to ~/Applications; --dmg packs it into target/release/Luna-<version>.dmg

set -euo pipefail

cd "$(dirname "$0")/.."
target_dir="${CARGO_TARGET_DIR:-target}"
version="$(sed -n 's/^version = "\(.*\)"$/\1/p' crates/zed/Cargo.toml | head -n 1)"
app="$target_dir/release/Luna.app"

# The terminal's libghostty-vt is built with Zig 0.15, which Homebrew installs keg-only.
if [ -d /opt/homebrew/opt/zig@0.15/bin ]; then
    export PATH="/opt/homebrew/opt/zig@0.15/bin:$PATH"
fi
command -v zig >/dev/null || { echo "Zig 0.15 is needed: brew install zig@0.15" >&2; exit 1; }

cargo build --release --package zed

rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$target_dir/release/luna" "$app/Contents/MacOS/luna"
cp crates/zed/resources/Document.icns "$app/Contents/Resources/Document.icns"

iconset="$(mktemp -d)/Luna.iconset"
mkdir -p "$iconset"
for size in 16 32 128 256 512; do
    sips -z "$size" "$size" crates/zed/resources/app-icon@2x.png --out "$iconset/icon_${size}x${size}.png" >/dev/null
    double=$((size * 2))
    sips -z "$double" "$double" crates/zed/resources/app-icon@2x.png --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil --convert icns "$iconset" --output "$app/Contents/Resources/Luna.icns"

{
    cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
<key>CFBundleName</key>
<string>Luna</string>
<key>CFBundleDisplayName</key>
<string>Luna</string>
<key>CFBundleIdentifier</key>
<string>io.github.gk7734.luna</string>
<key>CFBundleExecutable</key>
<string>luna</string>
<key>CFBundleIconFile</key>
<string>Luna</string>
<key>CFBundlePackageType</key>
<string>APPL</string>
<key>CFBundleShortVersionString</key>
<string>${version}</string>
<key>CFBundleVersion</key>
<string>${version}</string>
<key>LSApplicationCategoryType</key>
<string>public.app-category.developer-tools</string>
<key>LSMinimumSystemVersion</key>
<string>10.15.7</string>
<key>NSHighResolutionCapable</key>
<true/>
PLIST
    cat crates/zed/resources/info/*.plist
    cat <<PLIST
</dict>
</plist>
PLIST
} > "$app/Contents/Info.plist"
plutil -lint "$app/Contents/Info.plist" >/dev/null

# An ad-hoc signature keeps macOS from treating every rebuild as a new, unknown app.
codesign --force --deep --sign - "$app"

make_dmg() {
    local dmg="$target_dir/release/Luna-${version}.dmg"
    local staging writable_dmg volume
    staging="$(mktemp -d)"
    writable_dmg="$(mktemp -d)/Luna.dmg"
    volume="/Volumes/Luna"

    if [ -d "$volume" ]; then
        echo "$volume is already mounted; eject it first" >&2
        exit 1
    fi

    mkdir -p "$staging/.background"
    cp -R "$app" "$staging/Luna.app"
    cp crates/zed/resources/luna/dmg-background.tiff "$staging/.background/background.tiff"
    ln -s /Applications "$staging/Applications"
    hdiutil create -volname Luna -srcfolder "$staging" -fs HFS+ -format UDRW -ov "$writable_dmg" >/dev/null
    hdiutil attach -readwrite -noverify -noautoopen "$writable_dmg" >/dev/null

    # Finder keeps the window layout in the volume's .DS_Store, so it has to lay the window out
    # itself. The icon positions match the arrow and name tags drawn in dmg-background.svg, and
    # the hidden folders are moved out of sight for people who show hidden files.
    osascript <<APPLESCRIPT
tell application "Finder"
    tell disk "Luna"
        open
        set current view of container window to icon view
        set toolbar visible of container window to false
        set statusbar visible of container window to false
        set the bounds of container window to {200, 120, 860, 548}
        set viewOptions to the icon view options of container window
        set arrangement of viewOptions to not arranged
        set icon size of viewOptions to 128
        set text size of viewOptions to 13
        set background picture of viewOptions to file ".background:background.tiff"
        set extension hidden of item "Luna.app" to true
        set position of item "Luna.app" of container window to {180, 186}
        set position of item "Applications" of container window to {480, 186}
        try
            set position of item ".background" of container window to {900, 900}
        end try
        try
            set position of item ".fseventsd" of container window to {1000, 900}
        end try
        close
        open
        update without registering applications
        delay 2
        close
    end tell
end tell
APPLESCRIPT

    sync
    hdiutil detach "$volume" -quiet
    hdiutil convert "$writable_dmg" -format UDZO -imagekey zlib-level=9 -ov -o "$dmg" >/dev/null
    rm -rf "$staging" "$(dirname "$writable_dmg")"
    echo "Built $dmg"
}

case "${1:-}" in
    --install)
        mkdir -p "$HOME/Applications"
        rm -rf "$HOME/Applications/Luna.app"
        cp -R "$app" "$HOME/Applications/Luna.app"
        echo "Installed $HOME/Applications/Luna.app"
        ;;
    --dmg)
        make_dmg
        ;;
    *)
        echo "Built $app"
        ;;
esac
